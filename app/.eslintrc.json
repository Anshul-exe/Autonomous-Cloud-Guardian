{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "plugin:security/recommended"],
  "plugins": ["security"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-eval": "error",
    "security/detect-eval-with-expression": "error",
    "security/detect-child-process": "error",
    "security/detect-non-literal-fs-filename": "warn"
  }
}
